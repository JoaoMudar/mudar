erDiagram
  usos_insumo {
    uuid id PK
    uuid id_offline UK
    uuid insumo_id FK
    uuid especie_id FK
    uuid recipiente_id FK
    numeric quantidade
    date data_uso
  }
  custos_coleta_sementes {
    uuid id PK
    uuid especie_id FK
    text regiao_coleta
    numeric distancia_km
    numeric custo_combustivel
    numeric horas_mao_de_obra
    numeric custo_total
    int qtd_sementes_coletadas
    numeric custo_por_semente
  }
  atividades_producao {
    uuid id PK
    uuid atribuicao_id FK
    uuid especie_id FK
    uuid recipiente_id FK
    text tipo_atividade
    int quantidade
    date data_atividade
    uuid executado_por FK
    text observacoes
  }
  eventos_perda {
    uuid id PK
    uuid especie_id FK
    uuid recipiente_id FK
    int quantidade
    text causa
    date data_perda
    uuid registrado_por FK
    text observacoes
  }
  contagens_estoque {
    uuid id PK
    uuid especie_id FK
    uuid recipiente_id FK
    int quantidade_contada
    date data_contagem
    uuid contado_por FK
  }
  planos_semana {
    uuid id PK
    date inicio_semana UK
    text situacao
    uuid publicado_por FK
    timestamptz fechado_em
  }
  atribuicoes {
    uuid id PK
    uuid plano_semana_id FK
    uuid pessoa_id FK
    date data_trabalho
    text turno
    uuid tipo_tarefa_id FK
    uuid especie_id FK
    uuid recipiente_id FK
    int quantidade_planejada
    boolean e_recorrente
    text situacao
    text observacoes
  }
