flowchart TB
  subgraph PRODU["Cadastros de produto"]
    direction LR
    ESP["<b>Espécies</b><br/>nome popular · nome científico · sinônimos<br/>características · fotografia<br/>cadastro rápido · revisão de incompletos"]
    REC["<b>Recipientes</b><br/>tubete · sacos 10x18 a 28x32 · balde<br/>definem o tamanho da muda"]
    INS["<b>Insumos</b><br/>nome · unidade de medida"]
    ESP ~~~ REC ~~~ INS
  end

  subgraph CUSTO["Cadastros de custo"]
    direction LR
    CFX["<b>Custos fixos</b><br/>rateados sobre a produção"]
    COL["<b>Coleta de sementes</b><br/>origem própria da matéria-prima"]
    CFX ~~~ COL
  end

  subgraph PESSOAS["Cadastros de pessoas"]
    direction LR
    CLI["<b>Clientes</b><br/>pessoa física e jurídica<br/>consulta automática por CNPJ<br/>dados fiscais para nota<br/>cadastro rápido dentro do pedido"]
    FOR["<b>Fornecedores</b><br/>contato · cidade e estado<br/>espécies que fornece<br/>coordenadas por geocodificação"]
    FUN["<b>Funcionários</b><br/>vinculados às contas de acesso"]
    CLI ~~~ FOR ~~~ FUN
  end

  subgraph OPER["Cadastros de operação"]
    direction LR
    TIP["<b>Tipos de tarefa</b><br/>vocabulário da agenda de produção"]
  end

  subgraph CONS["Para onde os cadastros vão"]
    direction LR
    D1["<b>Custeio</b><br/>custo unitário por espécie e recipiente"]
    D2["<b>Produção</b><br/>consumo de insumos · atividades · perdas"]
    D3["<b>Pedidos</b><br/>itens · cliente · nota fiscal"]
    D4["<b>Cotações</b><br/>compra externa · mapa da rede"]
    D1 ~~~ D2 ~~~ D3 ~~~ D4
  end

  INS ~~~ CFX
  COL ~~~ CLI
  FUN ~~~ TIP

  ESP --> D1
  REC --> D1
  INS --> D1
  CFX --> D1
  COL --> D1
  ESP --> D2
  INS --> D2
  TIP --> D2
  ESP --> D3
  CLI --> D3
  FOR --> D4
  ESP --> D4

  subgraph LEG["Legenda"]
    direction LR
    L1["implementado no protótipo"]
    L2["parcialmente implementado"]
    L3["especificado, não implementado"]
    L1 ~~~ L2 ~~~ L3
  end
  D2 ~~~ LEG

  classDef feito fill:#e5e7eb,stroke:#374151,stroke-width:2px,color:#111827
  classDef parcial fill:#f3f4f6,stroke:#6b7280,stroke-width:2px,color:#111827,stroke-dasharray:7 4
  classDef futuro fill:#ffffff,stroke:#9ca3af,stroke-width:1.5px,color:#4b5563,stroke-dasharray:4 4
  classDef grupo fill:#fafafa,stroke:#d1d5db,stroke-width:1px,color:#374151

  class ESP,REC,INS,CFX,COL,CLI,FOR,FUN,D3,D4,L1 feito
  class D1,L2 parcial
  class TIP,D2,L3 futuro
  class PRODU,CUSTO,PESSOAS,OPER,CONS,LEG grupo
