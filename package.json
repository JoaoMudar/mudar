{
  "name": "viveiro-mudar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/migrate.ts && next build",
    "start": "next start",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "bash scripts/setup-hooks.sh",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:status": "tsx scripts/migrate.ts --status",
    "db:migrate:mark": "tsx scripts/migrate.ts --mark-applied",
    "sentry:teste": "tsx scripts/sentry-teste.ts",
    "db:seed-admin": "tsx scripts/seed-admin.ts",
    "db:seed-suppliers": "tsx scripts/seed-supplier-network.ts",
    "db:verifica-cadastro": "tsx scripts/verifica-cadastro-unico.ts",
    "db:refresh-local": "powershell -ExecutionPolicy Bypass -File scripts/refresh-local-db.ps1",
    "docs:tcc": "node scripts/build-docs-tcc.mjs",
    "docs:mapas": "node scripts/render-mapas.mjs",
    "docs:quadros": "node scripts/build-quadros-docx.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@sentry/nextjs": "^10.70.0",
    "leaflet": "^1.9.4",
    "next": "^16.2.3",
    "pg": "^8.20.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
}
