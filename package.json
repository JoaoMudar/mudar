{
  "name": "viveiro-mudar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/migrate.ts && next build",
    "start": "next start",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "bash scripts/setup-hooks.sh",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:status": "tsx scripts/migrate.ts --status",
    "db:migrate:mark": "tsx scripts/migrate.ts --mark-applied",
    "db:seed-admin": "tsx scripts/seed-admin.ts",
    "db:seed-suppliers": "tsx scripts/seed-supplier-network.ts",
    "db:refresh-local": "powershell -ExecutionPolicy Bypass -File scripts/refresh-local-db.ps1",
    "db:import-financeiro": "powershell -ExecutionPolicy Bypass -File scripts/import-financeiro.ps1",
    "bi:sanity": "tsx scripts/bi-sanity.ts",
    "db:conferir-despesas": "python scripts/conferir-despesas-excel.py"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "leaflet": "^1.9.4",
    "next": "^16.2.3",
    "pg": "^8.20.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.3",
    "postcss": "^8",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
}
