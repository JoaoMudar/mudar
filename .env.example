# Copie para `.env.local` e preencha. `.env.local` nunca vai para o git.

# --- Banco ---
# O driver e escolhido pelo HOST desta URL, nao pelo NODE_ENV (ver src/lib/db.ts):
#   host *.neon.tech  -> @neondatabase/serverless (evita esgotar conexao no serverless)
#   qualquer outro    -> pg, pool TCP
# Em desenvolvimento aponte para o Postgres local; na Vercel a variavel e definida
# no painel do projeto, apontando para o Neon.
DATABASE_URL=postgresql://postgres:senha@localhost:5432/viveiro

# Usadas apenas por scripts/refresh-local-db.ps1, que espelha o Neon num Postgres
# local descartavel (`npm run db:refresh-local`). A aplicacao nao le nenhuma das duas.
NEON_DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require
LOCAL_DATABASE_URL=postgresql://postgres:senha@localhost:5432/viveiro

# --- Aplicacao ---
# URL publica, usada para montar links absolutos (ex.: mensagem de WhatsApp).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Observabilidade ---
# DSN do projeto no Sentry. Deixe vazio para desligar o envio — o erro continua
# indo para o console. As duas recebem o mesmo valor: a primeira e usada no
# servidor, a segunda precisa do prefixo NEXT_PUBLIC_ para chegar ao browser.
# Ao trocar de projeto no Sentry, lembre de atualizar o host de ingest liberado
# no connect-src da CSP, em next.config.mjs.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Opcionais, so na Vercel: habilitam o envio de source maps, sem os quais o
# stack trace chega minificado. Ausentes, o build ignora a etapa e segue igual.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
